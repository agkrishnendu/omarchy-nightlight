#!/usr/bin/env python3
"""f.lux-style night light schedule for hyprsunset.

Part of the krisag.nightlight Omarchy shell plugin. Computes today's sunset
for your location and rewrites ~/.config/hypr/hyprsunset.conf with:

  sunset              -> evening temperature
  sunset + late-after -> late temperature (skipped when late-after is 0)
  off-time            -> off (identity)

Location comes from the Omarchy weather widget's setting
(~/.local/state/omarchy/settings/weather.json), else IP detection via
wttr.in, else the last cached coordinates.

The bar widget runs `sync` every 30 seconds, which keeps hyprsunset running,
regenerates the profiles when the day, settings or location change, and
re-applies any active override. hyprsunset reverts a manual temperature at its
next profile switch, so an override that outlives a switch is kept in
OVERRIDE and re-applied by `sync`.

  nightlight-schedule status [--json]
  nightlight-schedule set <kelvin|off> [--until next|morning|1h|30m|HH:MM] [--json]
  nightlight-schedule resume [--json]
  nightlight-schedule restart [--json]      # hyprsunset stopped answering IPC
  nightlight-schedule sync [schedule options] [--json]
  nightlight-schedule update [schedule options] [--force]

Schedule options (remembered until changed):
  --evening-temp K  --late-temp K  --late-after MINUTES  --off-time HH:MM
"""

import argparse
import json
import math
import re
import shutil
import subprocess
import sys
import time
import urllib.request
from datetime import date, datetime, timedelta, timezone
from pathlib import Path

DEFAULTS = {
    "evening_temp": 3400,
    "late_temp": 2700,
    "late_after": 180,
    "off_time": "07:00",
}

HOME = Path.home()
CONF = HOME / ".config/hypr/hyprsunset.conf"
CONF_BACKUP = HOME / ".config/hypr/hyprsunset.conf.pre-nightlight"
MARKER = "# Generated by the krisag.nightlight Omarchy plugin"
WEATHER_LOC = HOME / ".local/state/omarchy/settings/weather.json"
STATE = HOME / ".local/state/nightlight-schedule"
CACHE = STATE / "coords.json"
OVERRIDE = STATE / "override.json"
SCHEDULE_STATE = STATE / "schedule.json"


# --- location and sunset ----------------------------------------------------

def location():
    try:
        d = json.loads(WEATHER_LOC.read_text())
        return float(d["latitude"]), float(d["longitude"])
    except Exception:
        pass
    try:
        with urllib.request.urlopen("https://wttr.in/?format=j1", timeout=10) as r:
            area = json.load(r)["nearest_area"][0]
        coords = float(area["latitude"]), float(area["longitude"])
        CACHE.parent.mkdir(parents=True, exist_ok=True)
        CACHE.write_text(json.dumps(coords))
        return coords
    except Exception:
        pass
    try:
        return tuple(json.loads(CACHE.read_text()))
    except (OSError, ValueError):
        raise RuntimeError("no location: set one in the weather widget, or connect to the internet")


def sunset(lat, lon, day):
    """Local sunset time (NOAA solar position algorithm)."""
    n = day.timetuple().tm_yday
    g = 2 * math.pi / 365 * (n - 1)
    eqtime = 229.18 * (0.000075 + 0.001868 * math.cos(g) - 0.032077 * math.sin(g)
                       - 0.014615 * math.cos(2 * g) - 0.040849 * math.sin(2 * g))
    decl = (0.006918 - 0.399912 * math.cos(g) + 0.070257 * math.sin(g)
            - 0.006758 * math.cos(2 * g) + 0.000907 * math.sin(2 * g)
            - 0.002697 * math.cos(3 * g) + 0.00148 * math.sin(3 * g))
    phi = math.radians(lat)
    cos_ha = (math.cos(math.radians(90.833)) / (math.cos(phi) * math.cos(decl))
              - math.tan(phi) * math.tan(decl))
    ha = math.degrees(math.acos(max(-1.0, min(1.0, cos_ha))))
    utc_minutes = 720 - 4 * (lon - ha) - eqtime
    utc = datetime(day.year, day.month, day.day, tzinfo=timezone.utc) + timedelta(minutes=utc_minutes)
    return utc.astimezone()


# --- hyprsunset IPC ---------------------------------------------------------

def hyprctl(*args):
    try:
        r = subprocess.run(["hyprctl", "hyprsunset", *args],
                           capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.TimeoutExpired):
        return None
    out = r.stdout.strip()
    if r.returncode != 0 or out.startswith("Couldn't connect"):
        return None
    return out


def current_temp():
    """Temperature hyprsunset reports, or None if its IPC is unreachable.

    After `identity` it keeps reporting the previous temperature, so this
    can't tell whether the filter is off — the schedule/override decide that.
    """
    m = re.search(r"\d+", hyprctl("temperature") or "")
    return int(m.group()) if m else None


def hyprsunset_pid():
    r = subprocess.run(["pgrep", "-x", "hyprsunset"], capture_output=True, text=True)
    pids = r.stdout.split()
    return int(pids[0]) if pids else None


def apply(temp):
    """Set hyprsunset to `temp` kelvin, or identity (off) when None."""
    if temp is None:
        return hyprctl("identity") == "ok"
    return hyprctl("temperature", str(temp)) == "ok"


def start_hyprsunset():
    # Start it in its own systemd scope so it outlives whoever launched us
    if shutil.which("uwsm-app"):
        subprocess.run(["uwsm-app", "-t", "service", "--", "hyprsunset"], check=False)
    else:
        subprocess.Popen(["hyprsunset"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(50):
        if current_temp() is not None:
            break
        time.sleep(0.1)
    # A fresh hyprsunset applies its profile at the end of boot, clobbering
    # anything set before then
    time.sleep(1)


def stop_hyprsunset():
    subprocess.run(["pkill", "-x", "hyprsunset"], check=False)
    for _ in range(50):
        if hyprsunset_pid() is None:
            break
        time.sleep(0.1)
    time.sleep(0.5)  # let the compositor release the CTM manager


def restart_hyprsunset():
    stop_hyprsunset()
    start_hyprsunset()


# --- profile generation -----------------------------------------------------

def read_json(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return None


def write_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data))


def resolve_settings(args):
    """CLI options, else the last used settings, else DEFAULTS."""
    saved = (read_json(SCHEDULE_STATE) or {}).get("settings", {})
    settings = {}
    for key, default in DEFAULTS.items():
        value = getattr(args, key, None)
        settings[key] = value if value is not None else saved.get(key, default)
    return settings


def weather_mtime():
    try:
        return WEATHER_LOC.stat().st_mtime
    except OSError:
        return None


def needs_update(settings):
    state = read_json(SCHEDULE_STATE) or {}
    try:
        ours = CONF.read_text().startswith(MARKER)
    except OSError:
        ours = False
    return (not ours
            or state.get("date") != date.today().isoformat()
            or state.get("settings") != settings
            or state.get("weather_mtime") != weather_mtime())


def render_conf(settings, lat, lon, set_at):
    blocks = [
        (settings["off_time"], "identity = true"),
        (f"{set_at:%H:%M}", f"temperature = {settings['evening_temp']}"),
    ]
    # Skip the late profile when it would land at or after the morning off time
    oh, om = map(int, settings["off_time"].split(":"))
    until_off = (oh * 60 + om - (set_at.hour * 60 + set_at.minute)) % 1440
    if 0 < settings["late_after"] < until_off:
        late_at = set_at + timedelta(minutes=settings["late_after"])
        blocks.append((f"{late_at:%H:%M}", f"temperature = {settings['late_temp']}"))
    profiles = "".join(f"\nprofile {{\n    time = {t}\n    {body}\n}}\n" for t, body in blocks)
    return (f"{MARKER} — edits will be overwritten.\n"
            f"# Location {lat:.3f},{lon:.3f}; sunset today {set_at:%H:%M}\n"
            f"{profiles}")


def update(settings, force=False):
    """Regenerate hyprsunset.conf; restart hyprsunset if it changed."""
    if not force and not needs_update(settings):
        return False
    lat, lon = location()
    conf = render_conf(settings, lat, lon, sunset(lat, lon, date.today()))

    # Keep whatever the user had before we first took over the file
    if CONF.exists() and not CONF.read_text().startswith(MARKER) and not CONF_BACKUP.exists():
        shutil.copy2(CONF, CONF_BACKUP)

    changed = not CONF.exists() or CONF.read_text() != conf
    if changed:
        CONF.parent.mkdir(parents=True, exist_ok=True)
        CONF.write_text(conf)
    write_json(SCHEDULE_STATE, {"date": date.today().isoformat(), "settings": settings,
                                "weather_mtime": weather_mtime()})
    if changed and hyprsunset_pid() is not None:
        restart_hyprsunset()
    return changed


# --- schedule ---------------------------------------------------------------

def load_profiles():
    """[(minutes since midnight, kelvin or None for identity)] from CONF."""
    profiles = []
    try:
        text = CONF.read_text()
    except OSError:
        return profiles
    for block in re.findall(r"profile\s*\{(.*?)\}", text, re.S):
        t = re.search(r"time\s*=\s*(\d{1,2}):(\d{2})", block)
        if not t:
            continue
        temp = re.search(r"temperature\s*=\s*(\d+)", block)
        if re.search(r"identity\s*=\s*true", block) or not temp:
            kelvin = None
        else:
            kelvin = int(temp.group(1))
        profiles.append((int(t.group(1)) * 60 + int(t.group(2)), kelvin))
    return sorted(profiles)


def occurrences(profiles, now):
    """Profile start times from yesterday through the day after tomorrow."""
    midnight = now.replace(hour=0, minute=0, second=0, microsecond=0)
    return sorted((midnight + timedelta(days=d, minutes=m), k)
                  for d in (-1, 0, 1, 2) for m, k in profiles)


def active_and_next(occ, now):
    past = [o for o in occ if o[0] <= now]
    future = [o for o in occ if o[0] > now]
    return (past[-1] if past else None), (future[0] if future else None)


def hold_until(hold, now, occ):
    """Resolve an --until value to the datetime the override ends."""
    _, nxt = active_and_next(occ, now)
    if hold == "next":
        return nxt[0] if nxt else now + timedelta(hours=1)
    if hold == "morning":
        off = [dt for dt, k in occ if dt > now and k is None]
        return off[0] if off else hold_until("next", now, occ)
    m = re.fullmatch(r"(\d+)([mh])", hold)
    if m:
        n = int(m.group(1))
        return now + (timedelta(hours=n) if m.group(2) == "h" else timedelta(minutes=n))
    m = re.fullmatch(r"(\d{1,2}):(\d{2})", hold)
    if m:
        at = now.replace(hour=int(m.group(1)), minute=int(m.group(2)), second=0, microsecond=0)
        return at if at > now else at + timedelta(days=1)
    raise ValueError(f"bad --until value: {hold}")


def enforce_override():
    """Expire a finished override, or re-apply a live one hyprsunset undid."""
    now = datetime.now()
    occ = occurrences(load_profiles(), now)
    ov = read_json(OVERRIDE)
    if ov is None:
        return
    if ov["until"] <= now.timestamp():
        OVERRIDE.unlink(missing_ok=True)
        active, _ = active_and_next(occ, now)
        if active:
            apply(active[1])
        return

    pid = hyprsunset_pid()
    # An apply within a minute of a profile switch may have raced hyprsunset
    # switching, and identity can't be verified by reading back, so redo it
    switched = any(dt <= now and ov["applied_at"] < dt.timestamp() + 60 for dt, _ in occ)
    drifted = ov["temperature"] is not None and current_temp() != ov["temperature"]
    if switched or drifted or pid != ov.get("pid"):
        if apply(ov["temperature"]):
            ov["applied_at"] = now.timestamp()
            ov["pid"] = pid
            write_json(OVERRIDE, ov)


def sync(settings):
    """Everything the widget's poll needs; returns a problem string or None."""
    problem = None
    try:
        update(settings)
    except Exception as e:
        problem = str(e)
    if hyprsunset_pid() is None and CONF.exists():
        start_hyprsunset()
    enforce_override()
    return problem


def set_override(value, hold):
    now = datetime.now()
    temp = None if value == "off" else max(1000, min(20000, int(value)))
    until = hold_until(hold, now, occurrences(load_profiles(), now))
    ok = apply(temp)
    write_json(OVERRIDE, {
        "temperature": temp,
        "hold": hold,
        "until": until.timestamp(),
        # 0 makes the next sync retry if hyprsunset didn't take it
        "applied_at": now.timestamp() if ok else 0,
        "pid": hyprsunset_pid(),
    })
    return ok


def resume():
    OVERRIDE.unlink(missing_ok=True)
    now = datetime.now()
    active, _ = active_and_next(occurrences(load_profiles(), now), now)
    return apply(active[1]) if active else True


# --- output -----------------------------------------------------------------

def status(problem=None):
    now = datetime.now()
    profiles = load_profiles()
    occ = occurrences(profiles, now)
    active, nxt = active_and_next(occ, now)
    ov = read_json(OVERRIDE)
    if ov and ov["until"] <= now.timestamp():
        ov = None
    temp = current_temp()
    scheduled = active[1] if active else None
    return {
        "ok": temp is not None,
        "running": hyprsunset_pid() is not None,
        "problem": problem,
        "temperature": temp,
        "effective": ov["temperature"] if ov else scheduled,
        "night": scheduled is not None,
        "scheduled": {"time": active[0].strftime("%H:%M"), "temperature": scheduled} if active else None,
        "next": {"time": nxt[0].strftime("%H:%M"), "temperature": nxt[1],
                 "epoch": int(nxt[0].timestamp())} if nxt else None,
        "override": {
            "temperature": ov["temperature"],
            "hold": ov["hold"],
            "until": int(ov["until"]),
            "untilLabel": datetime.fromtimestamp(ov["until"]).strftime("%H:%M"),
        } if ov else None,
        "profiles": [{"time": f"{m // 60:02d}:{m % 60:02d}", "temperature": k} for m, k in profiles],
        "presets": sorted({k for _, k in profiles if k is not None}, reverse=True),
    }


def kelvin_label(k):
    return "off" if k is None else f"{k}K"


def print_status(as_json, problem=None):
    s = status(problem)
    if as_json:
        print(json.dumps(s))
        return
    if s["problem"]:
        print(f"problem: {s['problem']}")
    if not s["running"]:
        print("hyprsunset is not running")
    elif not s["ok"]:
        print("hyprsunset is running but not answering IPC (try: nightlight-schedule restart)")
    line = f"now {kelvin_label(s['effective'])}"
    if s["override"]:
        line += f" (override until {s['override']['untilLabel']})"
    elif s["next"]:
        line += f", {kelvin_label(s['next']['temperature'])} at {s['next']['time']}"
    print(line)


# --- CLI --------------------------------------------------------------------

def hhmm(value):
    if not re.fullmatch(r"([01]?\d|2[0-3]):[0-5]\d", value):
        raise argparse.ArgumentTypeError("expected HH:MM")
    h, m = value.split(":")
    return f"{int(h):02d}:{m}"


def main():
    p = argparse.ArgumentParser(description="hyprsunset sunset schedule and overrides")
    sub = p.add_subparsers(dest="cmd", required=True)

    schedule = argparse.ArgumentParser(add_help=False)
    schedule.add_argument("--evening-temp", dest="evening_temp", type=int)
    schedule.add_argument("--late-temp", dest="late_temp", type=int)
    schedule.add_argument("--late-after", dest="late_after", type=int,
                          help="minutes after sunset to switch to the late temperature; 0 disables")
    schedule.add_argument("--off-time", dest="off_time", type=hhmm)

    up = sub.add_parser("update", parents=[schedule], help="regenerate today's profiles")
    up.add_argument("--force", action="store_true")
    sub.add_parser("sync", parents=[schedule],
                   help="keep hyprsunset, profiles and override current").add_argument("--json", action="store_true")
    for name in ("status", "resume", "restart"):
        sub.add_parser(name).add_argument("--json", action="store_true")
    sp = sub.add_parser("set", help="override the temperature")
    sp.add_argument("value", help="kelvin, or 'off'")
    sp.add_argument("--until", default="next",
                    help="next (profile switch, default), morning, 1h, 30m or HH:MM")
    sp.add_argument("--json", action="store_true")
    args = p.parse_args()

    if args.cmd == "update":
        if update(resolve_settings(args), force=args.force):
            print("profiles updated")
            enforce_override()
        print_status(False)
        return

    ok, problem = True, None
    if args.cmd == "set":
        if args.value != "off" and not args.value.isdigit():
            p.error("value must be kelvin or 'off'")
        try:
            ok = set_override(args.value, args.until)
        except ValueError as e:
            p.error(str(e))
    elif args.cmd == "resume":
        ok = resume()
    elif args.cmd == "restart":
        restart_hyprsunset()
        enforce_override()
    elif args.cmd == "sync":
        problem = sync(resolve_settings(args))

    print_status(args.json, problem)
    sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
